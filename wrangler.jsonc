{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "terrascope",
  "main": "worker.js",
  "compatibility_date": "2026-08-26",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/briefing", "/api/*"]
  }
}
